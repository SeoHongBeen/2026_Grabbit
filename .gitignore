# 오디오 파일 전반
*.wav
*.mp3
*.flac
*.aif
*.aiff
*.ogg

# 특징 파일 (data/build_dataset.py, data/build_embeddings.py 가 재생성)
ai/dataset/mfcc/*.npy
ai/dataset/mfcc/*.npz
ai/dataset/mfcc/*.png

# 표 형식 데이터
*.csv
*.xlsx

# 예외: 작지만 재현에 꼭 필요한 것
#   manifest.csv — 어떤 파일이 어느 클래스인지. 지하철 차임 제외 같은
#                  우리가 내린 판단이 담겨 있어 잃으면 복원이 번거롭다
!ai/dataset/FSD50K/manifest.csv
!ai/dataset/UrbanSound8K/manifest.csv

#   임계값·정규화 통계 — 몇백 바이트짜리 배포 설정
!ai/dataset/mfcc/thresholds_*.npy
!ai/dataset/mfcc/consecutive_*.npy
!ai/dataset/mfcc/norm_*.npy
!ai/dataset/mfcc/test_indices.npy

# AI 구버전 산출물
ai/features/
toMFCC.png


# ==========================================================
# 모델 가중치
# ==========================================================
*.pt
*.pth
*.onnx
*.tflite

# 예외: RPi에 넘기는 배포 결과물.
# *.pth 와 *.tflite 를 모두 제외하면 저장소에 학습 결과가 하나도 안 남아,
# 28GB 데이터를 다시 받아 재학습하지 않는 한 복원할 수 없다.
!ai/export/grabbit_model.npz


